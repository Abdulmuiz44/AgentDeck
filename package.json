{
  "name": "talocode",
  "version": "0.1.0",
  "description": "Legacy Talocode experiment for local agent orchestration.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && node scripts/start-electron.mjs\"",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.build.json",
    "build:renderer": "vite build",
    "start": "node scripts/start-electron.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-tests/tests/*.test.js",
    "smoke": "node scripts/smoke-test.mjs",
    "talo": "node dist/cli/index.js",
    "agentdeck": "node dist/cli/index.js"
  },
  "keywords": [
    "electron",
    "terminal",
    "ai",
    "developer-tools",
    "workspace"
  ],
  "license": "MIT",
  "dependencies": {
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron-builder": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.talocode.app",
    "productName": "Talocode",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  },
  "bin": {
    "talo": "./dist/cli/index.js",
    "agentdeck": "./dist/cli/index.js"
  },
  "optionalDependencies": {
    "electron": "^33.4.11",
    "node-pty": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/talocode/talocode.git"
  },
  "bugs": {
    "url": "https://github.com/talocode/talocode/issues"
  },
  "homepage": "https://github.com/talocode/talocode#readme"
}
